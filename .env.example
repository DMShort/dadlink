POSTGRES_PASSWORD=<generated-random-string>
JWT_SECRET=<generated-random-string-at-least-48-chars>

# Bootstrap (only needed on first run — ignored after org exists)
BOOTSTRAP_ORG_NAME=My Family
BOOTSTRAP_ORG_TAG=family
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<change-me-on-first-login>

# --- Login with Discord (optional) ---
# 1. https://discord.com/developers/applications -> New Application -> OAuth2
# 2. Add redirect: https://<your-server>:9000/auth/discord/callback  (must match DISCORD_REDIRECT_URI exactly)
# 3. Copy the Client ID and Client Secret here.
# DISCORD_GUILD_ID: your Discord server's ID. Only its members can log in, and their Discord roles
# sync to DadLink roles that have a matching "Discord role ID" (Admin Panel > Roles).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_GUILD_ID=
